*.o
*.elf
*.map
*.d
**/nbproject/private
**/nbproject/Makefile-*
**/nbproject/Package-*
**/nbproject/project.properties
**/*.X/debug
**/*.X/dist
**/*.X/build
**/*.X/.generated_files
**/*.IAR/Debug
**/*.IAR/settings
**/*.IAR/*.dep
**/*.IAR/*.custom_argvars

# Per-machine tool config (written by setup_compiler.py) - never commit
setup_compiler.config

# Python cache
__pycache__/
*.pyc
*.pyo

# Per-machine virtual environment, created by install_dependencies.bat
# (called from setup.bat). Never commit - it holds a machine-specific
# absolute path and compiled/platform-specific packages (pyocd, sv-ttk).
.venv/

# MCC backup artifacts (written when migrating .mc3 -> the v5.6 YAML model)
*.mc3.bak0
*.bak0

# probe selection is per-machine: install.bat writes it, the serial means
# nothing on another bench (and a wrong -u makes flash.bat fail outright).
bench.json

# gui_term.py's COM-port-to-name assignment - per-machine, written by its own
# "Setup > Configure Ports" dialog, not something to carry across a clone.
term_ports.json

# scripts/bandwidth_ramp_client.c's compiled binary - one gcc command away
# (see the comment at the top of that file), never commit the .exe itself.
scripts/bandwidth_ramp_client.exe
